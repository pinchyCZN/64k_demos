    <ClCompile Include="xcursion\xcursion_ground.c" />
    <ClCompile Include="xcursion\xcursion_roto.c" />
    <ClCompile Include="xcursion\xcursion_warp.c" />
    <ClCompile Include="xcursion\xcursion_moire.c" />
    <ClCompile Include="xcursion\xcursion_battle.c" />
    <ClCompile Include="xcursion\xcursion_beams.c" />
    <ClCompile Include="xcursion\xcursion_tunnel.c" />
    <ClCompile Include="xcursion\xcursion_water.c" />
    <ClCompile Include="xcursion\xcursion_pal.c" />
    <ClCompile Include="xcursion\xcursion_plasma.c" />
    <ClCompile Include="xcursion\xcursion_text.c" />
    <ClCompile Include="xcursion\xcursion_voxel.c" />
    <ClCompile Include="xcursion\xcursion_scroll.c" />
    <ClCompile Include="xcursion\xcursion_mesh.c" />
    <ClCompile Include="xcursion\xcursion_countdown.c" />
    <ClCompile Include="xcursion\xcursion_tables.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="pd.h" />
    <ClInclude Include="host.h" />
    <ClInclude Include="xcurpack.h" />
    <ClInclude Include="xcursion\xcursion.h" />
    <ClInclude Include="xcursion\xcursion_assets.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
